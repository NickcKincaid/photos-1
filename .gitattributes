# Keep text consistent on Windows, macOS and Linux; protect binary assets.
* text=auto
*.json text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
